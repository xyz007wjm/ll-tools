# 统一换行符：仓库内一律存 LF，检出时按平台处理
* text=auto

# Windows 脚本必须是 CRLF：PowerShell 5.1 与 cmd.exe 对 LF-only 的 .bat 处理不稳
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.cs    text eol=crlf

# 文档保持 LF
*.md    text eol=lf

# 二进制文件禁止任何换行符/编码转换
*.exe   binary
*.zip   binary
*.ico   binary
*.png   binary
*.dll   binary
